// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum Mood {
  happy
  sad
  angry
  silly

  @@map("mood")
}

model Quack {
  id        String   @id @default(cuid())
  text      String   @db.Text
  mood      Mood?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  // The optional poll attached to the quack. The quack text is its question.
  poll      Poll?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@map("quack")
}

enum PollResultsVisibility {
  immediately
  after_vote

  @@map("poll_results_visibility")
}

enum PollSuggestions {
  not_allowed
  published
  author_approves

  @@map("poll_suggestions")
}

enum PollOptionStatus {
  published
  pending

  @@map("poll_option_status")
}

// The defaults are the least restrictive values: a poll that predates a setting
// behaves as if it had no end, showed results at once and took no suggestions.
model Poll {
  quack             Quack                 @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId           String                @id
  // Null for a poll that never ends.
  endsAt            DateTime?
  resultsVisibility PollResultsVisibility @default(immediately)
  suggestions       PollSuggestions       @default(not_allowed)
  createdAt         DateTime              @default(now())
  options           PollOption[]
  votes             PollVote[]

  @@map("poll")
}

model PollOption {
  id             String           @id @default(cuid())
  poll           Poll             @relation(fields: [pollId], references: [quackId], onDelete: Cascade)
  pollId         String
  text           String           @db.VarChar(80)
  // Trimmed and lower-cased. Unique per poll, so the database itself refuses
  // two answers that differ only in case or surrounding spaces.
  normalizedText String           @db.VarChar(80)
  status         PollOptionStatus @default(published)
  // Order of publication. Null while a suggestion waits for approval.
  position       Int?
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById    String
  createdAt      DateTime         @default(now())
  votes          PollVote[]

  @@unique([pollId, normalizedText])
  @@index([createdById])
  @@map("poll_option")
}

// A user's current choice in a poll. The primary key allows one per user and
// poll; counts are always computed from these rows, never stored.
model PollVote {
  poll      Poll       @relation(fields: [pollId], references: [quackId], onDelete: Cascade)
  pollId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@id([pollId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean
  image         String?      @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quacks        Quack[]
  pollOptions   PollOption[]
  pollVotes     PollVote[]
  role          UserRole     @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  // Profile settings the user edits on the Settings page.
  bio             String? @db.VarChar(160)
  // Preselected in the new-quack form; null for no mood.
  defaultMood     Mood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
